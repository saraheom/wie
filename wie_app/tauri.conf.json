{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WIPI Player",
  "version": "0.1.43",
  "identifier": "com.jjunnyy.wieplayer",
  "build": {
    "frontendDist": "../wie_web/dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "cd .. && npm start",
    "beforeBuildCommand": "cd .. && npm run build:prod"
  },
  "app": {
    "windows": [
      {
        "title": "WIPI Player",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": [
        {
          "identifier": "default",
          "description": "enables the default permissions",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default"
          ]
        }
      ],
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/Square310x310Logo.png",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "15.0",
      "infoPlist": "Info.plist"
    }
  }
}
